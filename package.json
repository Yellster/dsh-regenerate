{
  "name": "dsh-regenerate",
  "version": "1.1.0",
  "description": "Regenerate assistant answers and edit/resend sent user prompts in the DSH conversation.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yellster/dsh-regenerate.git"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
